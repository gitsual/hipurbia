# Example hardware facts, for documentation and fixtures.
#
# The real file is generated by scripts/hardware-facts.sh --emit and lives in
# $XDG_STATE_HOME/archlinux-portfolio/hardware-facts. It is never committed:
# it describes one machine, and this repository describes a configuration.
#
# To correct a fact rather than re-detect it, put the same key in
# $XDG_CONFIG_HOME/archlinux-portfolio/hardware-facts.override. The override is
# merged last, so it always wins.
#
# Only the keys in FACTS_ALLOWED_KEYS (lib/facts.sh) can appear here. That
# allowlist is what keeps serials, MAC addresses, hostnames and usernames out
# of a file that ends up attached to bug reports.
FACTS_SCHEMA=1
chassis=laptop
has_backlight=yes
has_battery=yes
has_bluetooth=yes
has_touchpad=yes
has_wifi=yes
virt=none
