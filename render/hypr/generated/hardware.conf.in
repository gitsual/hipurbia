# Generated by scripts/render-config.sh from this machine's hardware facts.
# Do not edit: correct the facts in the override file and re-render.
#
# The NVIDIA environment applies only when NVIDIA is the sole GPU. On a hybrid
# laptop the integrated GPU drives the displays and these variables would
# point Wayland at the wrong device; hybrid handling is a later unit.
@?gpu_vendors~nvidia && gpu_hybrid=no@env = LIBVA_DRIVER_NAME,nvidia
@?gpu_vendors~nvidia && gpu_hybrid=no@env = GBM_BACKEND,nvidia-drm
@?gpu_vendors~nvidia && gpu_hybrid=no@env = __GLX_VENDOR_LIBRARY_NAME,nvidia
@?gpu_vendors~nvidia && gpu_hybrid=no@env = NVIDIA_FORCE_PROBE,1
@?gpu_vendors~nvidia && gpu_hybrid=no || virt!=none@cursor { no_hardware_cursors = true }
