# Generated by scripts/render-config.sh from this machine's hardware facts.
# Do not edit: correct the facts in the override file and re-render.
input {
    kb_layout = @SETTING_XKB_LAYOUT@
    follow_mouse = 1
@?has_touchpad=yes@    touchpad {
@?has_touchpad=yes@        natural_scroll = true
@?has_touchpad=yes@        tap-to-click = true
@?has_touchpad=yes@    }
}
